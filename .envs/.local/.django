# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_RUN_MIGRATIONS=True
IPYTHONDIR=/app/.ipython
DJANGO_TENANT_USERS_DOMAIN=localhost
TAILWIND_CLI_AUTOMATIC_DOWNLOAD=True
CR_REGISTER_PANELS=True
CR_REGISTER_REDIS_PANEL=True
CR_REGISTER_CACHE_PANEL=True
CR_REGISTER_URLS_PANEL=True
CR_REGISTER_CELERY_PANEL=True
CR_REGISTER_SENTRY_PANEL=True
SENTRY_API_BASE_URL=https://sentry.io/api/0
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
SENTRY_AUTH_TOKEN=
SENTRY_DEFAULT_ISSUES_QUERY=is:unresolved

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

